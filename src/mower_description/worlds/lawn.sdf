    </model>

    <!-- ========== 1. DOLNA ŚCIANA (Y = -10) ========== -->
    <model name="apriltag_id0">
      <static>true</static>
      <!-- Skierowany w stronę wnętrza (+Y). Odsunięty od ściany na -9.89 -->
